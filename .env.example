# Copy this file to .env.local and fill in your own values.
# Get your Cohesivity credentials by running the genesis API:
# curl -s -X POST https://cohesivity.ai/api/genesis -H "User-Agent: supermaster/1.0"

COH_APP_KEY=your_cohesivity_application_key_here

# Passcode to enter the app (set to whatever you want)
APP_PASSCODE=your_passcode_here

# Random secret for signing session cookies — use a long random string
APP_SECRET=your_random_secret_here_at_least_32_chars
